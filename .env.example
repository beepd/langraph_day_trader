A# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).
# Lines starting with # are comments. Leave a value empty if you don't use that feature.

# --- Language model: pick ONE provider and set its key ---------------------------------------
LLM_PROVIDER=gemini                 # gemini | openai | groq | mistral | openrouter
LLM_MODEL=gemini-2.5-flash          # e.g. gpt-4.1-mini for openai
# LLM_TEMPERATURE=                  # optional: a number sets it, an empty value leaves it out (reasoning models refuse it)

GOOGLE_API_KEY=                     # for gemini (Google AI Studio)
OPENAI_API_KEY=                     # for openai
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# --- Database (Supabase). Use a SEPARATE test project on your laptop ---------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=                       # the SECRET key (server-side only, used by the jobs)
SUPABASE_PUBLISHABLE_KEY=           # the public read-only key (used only by the dashboard)

# --- Telegram notifications (optional) ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=1                  # 0 mutes every message (use on test machines)

# --- Market calendar -----------------------------------------------------------------------------
# Trading holidays that fall on weekdays, as YYYY-MM-DD (two-digit month and day), comma-separated:
NSE_HOLIDAYS=

# --- Scheduler (IST) -------------------------------------------------------------------------------
MORNING_TIME=09:35
SETTLE_TIME=15:40
# MORNING_SCRIPT=morning_run.py     # which files the scheduler launches (these are the defaults)
# SETTLE_SCRIPT=settle_day.py

# --- Testing switches (leave off in production; the scheduler forces them off anyway) ---------
FORCE_RUN=0
FORCE_SETTLE=0
DASHBOARD_DEMO=0
